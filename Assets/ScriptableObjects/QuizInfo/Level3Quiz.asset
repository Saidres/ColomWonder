  quizSceneName: Level3
  quizName: Level 3 Quiz
  quizDescription: This quiz will test your knowledge about the Level 1 environment.
  questions:
  - questionText: "\xBFD\xF3nde comienza la historia del juego?"
    questionImage: {fileID: 0}
    answers:
    - En un castillo abandonado
    - En una ciudad futurista
    - En Las Lajas
    - "En la cima de una monta\xF1a"
    correctAnswerIndex: 2
  - questionText: "\xBFQu\xE9 criatura misteriosa se menciona en este nivel?"
    questionImage: {fileID: 0}
    answers:
    - "Un drag\xF3n"
    - Un duende
    - Un fantasma
    - Un ogro
    correctAnswerIndex: 1
  - questionText: "\xBFQu\xE9 consejo da el campesino sobre el duende?"
    questionImage: {fileID: 0}
    answers:
    - Que lo sigas para encontrar oro
    - Que lo invites a comer
    - "Que corras si lo oyes re\xEDr"
    - Que cantes para espantarlo
    correctAnswerIndex: 2
