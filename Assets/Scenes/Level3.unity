      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: 'Bienvenido a Las Lajas, joven aventurero! '
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: "Aqu\xED encontrar\xE1s monta\xF1as llenas de vida, senderos de caf\xE9
        que huelen a historia y vistas que quitan el aliento.  "
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: "Si te gusta la naturaleza, este es tu para\xEDso."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[3].sentence
      value: "(baja la voz) tambi\xE9n se dice que entre los \xE1rboles vive un duende
        travieso."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[0].dialogueCharacter
